<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>liw_oam</name>
  <version>0.1.0</version>
  <description>Lidar-Inertial Odometry and Mapping (LIW-OAM) for ROS2</description>
  
  <maintainer email="wqj@todo.todo">wqj</maintainer>
  <license>Apache License 2.0</license>
  
  <author email="wqj@todo.todo">wqj</author>
  
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <!-- ROS2 dependencies -->
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>
  
  <!-- PCL dependencies -->
  <depend>pcl_conversions</depend>
  <depend>pcl_msgs</depend>
  
  <!-- Point Cloud Library -->
  <depend>libpcl-dev</depend>
  
  <!-- Ceres Solver -->
  <depend>libceres-dev</depend>
  
  <!-- Eigen -->
  <depend>libeigen3-dev</depend>
  
  <!-- Additional system dependencies -->
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  
  <!-- Test dependencies -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>